# Postgres
POSTGRES_USER=yt2tt
POSTGRES_PASSWORD=yt2tt
POSTGRES_DB=yt2tt
DATABASE_URL=postgresql+asyncpg://yt2tt:yt2tt@postgres:5432/yt2tt

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# S3 / MinIO
# Dev: gunakan MinIO (lihat docker-compose.yml)
# Prod: isi dengan credentials AWS S3 dan kosongkan S3_ENDPOINT_URL / S3_PUBLIC_ENDPOINT_URL
S3_BUCKET=yt2tt-dev
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_PRESIGN_EXPIRES=86400

# Media workdir (inside container)
MEDIA_DIR=/tmp/yt2tt

# App
APP_ENV=dev
APP_CORS_ORIGINS=http://localhost:3000

# TikTok Content Posting API v2 (https://developers.tiktok.com/)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/auth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.upload,video.publish
TIKTOK_POST_CONNECT_REDIRECT=http://localhost:3000

# Fernet key for encrypting stored OAuth tokens.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
